# Backend environment example for SoleID

# Qdrant settings
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Google Drive service account JSON (inline or path). If empty, Drive ops fall back to local.
DRIVE_SERVICE_ACCOUNT_JSON=

# Pricing providers
EBAY_APP_ID=
ENABLE_UNOFFICIAL_STOCKX=false

# Cache
REDIS_URL=

# Logging
LOG_LEVEL=INFO
